{
  "pipeline": "HyperparameterTuning",
  "source_tables": {
    "book_ratings": "gold.book_ratings"
  },
  "storage": {
    "schema": "gold",
    "table": "recommendations"
  },
  "model": {
    "algorithm": "ALS",
    "params": {
      "cold_start_strategy": "drop"
    },
    "train_test_split": 0.8,
    "seed": 42,
    "top_n_recommendations": 10,
    "tuning": {
      "num_folds": 3,
      "param_grid": {
        "rank": [10, 50, 100],
        "reg_param": [0.01, 0.1, 0.5],
        "max_iter": [10, 20]
      }
    }
  },
  "mlflow": {
    "experiment_name": "/Users/tharcisio.leone@x1f-fink.one/poc/book_recommender",
    "run_name": "als_hyperparameter_tuning"
  }
}