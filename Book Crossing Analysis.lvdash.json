{
  "datasets": [
    {
      "name": "top10_popular_books",
      "displayName": "Top 10 Most Popular Books",
      "queryLines": [
        "SELECT\n",
        "  title,\n",
        "  rating_count,\n",
        "  avg_rating\n",
        "FROM\n",
        "  gold.books_summary\n",
        "WHERE\n",
        "  rating_count >= 30\n",
        "ORDER BY\n",
        "  rating_count DESC\n",
        "LIMIT 10"
      ],
      "catalog": "hive_metastore",
      "schema": "gold"
    },
    {
      "name": "top10_rated_authors",
      "displayName": "Top 10 Best-Rated Authors",
      "queryLines": [
        "SELECT\n",
        "  author,\n",
        "  avg_rating,\n",
        "  total_ratings\n",
        "FROM\n",
        "  gold.authors_summary\n",
        "WHERE\n",
        "  total_ratings >= 20\n",
        "ORDER BY\n",
        "  avg_rating DESC\n",
        "LIMIT 10"
      ],
      "catalog": "hive_metastore",
      "schema": "gold"
    },
    {
      "name": "author_publisher_combos",
      "displayName": "Top 10 Author-Publisher Combinations",
      "queryLines": [
        "SELECT\n",
        "  br.author,\n",
        "  br.publisher,\n",
        "  AVG(br.book_rating) AS avg_rating,\n",
        "  COUNT(*) AS rating_count\n",
        "FROM\n",
        "  gold.book_ratings br\n",
        "WHERE\n",
        "  br.year_of_publication BETWEEN 1990 AND 2006\n",
        "GROUP BY\n",
        "  br.author,\n",
        "  br.publisher\n",
        "HAVING\n",
        "  COUNT(*) >= 10\n",
        "ORDER BY\n",
        "  avg_rating DESC\n",
        "LIMIT 10"
      ],
      "catalog": "hive_metastore",
      "schema": "gold"
    },
    {
      "name": "rating_distribution",
      "displayName": "Rating Distribution",
      "queryLines": [
        "SELECT\n",
        "  book_rating,\n",
        "  COUNT(*) AS count\n",
        "FROM\n",
        "  gold.book_ratings\n",
        "WHERE\n",
        "  book_rating > 0\n",
        "GROUP BY\n",
        "  book_rating\n",
        "ORDER BY\n",
        "  book_rating"
      ],
      "catalog": "hive_metastore",
      "schema": "gold"
    },
    {
      "name": "publications_timeline",
      "displayName": "Publications Timeline",
      "queryLines": [
        "SELECT\n",
        "  year_of_publication,\n",
        "  COUNT(*) AS book_count\n",
        "FROM\n",
        "  gold.book_ratings\n",
        "WHERE\n",
        "  year_of_publication BETWEEN 1990 AND 2006\n",
        "GROUP BY\n",
        "  year_of_publication\n",
        "ORDER BY\n",
        "  year_of_publication"
      ],
      "catalog": "hive_metastore",
      "schema": "gold"
    },
    {
      "name": "top10_books_avg_rating",
      "displayName": "Top 10 Books by Average Rating",
      "queryLines": [
        "SELECT\n",
        "  title,\n",
        "  AVG(book_rating) AS avg_rating,\n",
        "  COUNT(*) AS rating_count\n",
        "FROM\n",
        "  gold.book_ratings\n",
        "WHERE\n",
        "  book_rating > 0\n",
        "GROUP BY\n",
        "  title\n",
        "HAVING\n",
        "  COUNT(*) >= 20\n",
        "ORDER BY\n",
        "  avg_rating DESC\n",
        "LIMIT 10"
      ],
      "catalog": "hive_metastore",
      "schema": "gold"
    }
  ],
